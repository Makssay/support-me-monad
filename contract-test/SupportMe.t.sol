pragma solidity 0.8.28;
import "../contracts/SupportMe.sol";
import "./MockEntropy.sol";
interface Vm { function deal(address,uint256) external; function prank(address) external; function expectRevert(bytes calldata) external; function warp(uint256) external; function addr(uint256) external returns(address); function sign(uint256,bytes32) external returns(uint8,bytes32,bytes32); }
contract RejectWallet {
 SupportMe s;constructor(SupportMe a){s=a;}function submit(uint256 id)external{s.submitContribution(id,"work");}function create()external payable{s.createMissionPaid{value:msg.value}(1 ether,uint64(block.timestamp+1 days),259200,SupportMeStorage.Mode.CreatorChoice,86400,"brief",0);}function close(uint256 id)external{s.closeMission(id);}function withdraw(address payable a)external{s.withdrawCredit(a);}receive()external payable{revert();}
}
contract ReenterWallet {SupportMe s;uint256 public calls;constructor(SupportMe a){s=a;}function submit(uint256 id)external{s.submitContribution(id,"work");}receive()external payable{calls++;(bool ok,)=address(s).call(abi.encodeCall(s.approveContribution,(uint256(1))));require(!ok);}}
contract SupportMeTest {
 Vm constant vm=Vm(address(uint160(uint256(keccak256("hevm cheat code")))));SupportMe s;MockEntropy e;address creator=address(0xA);address user=address(0xB);address other=address(0xC);uint256 pk=123456;
 function setUp()public{e=new MockEntropy();s=new SupportMe(address(e),vm.addr(pk),address(0));vm.deal(address(this),100 ether);vm.deal(creator,100 ether);vm.deal(user,1 ether);vm.deal(other,1 ether);}
 function check(bool b)internal pure{require(b,"Assertion failed");}
 function make(SupportMeStorage.Mode mode,uint256 slots)internal{vm.prank(creator);s.createMissionPaid{value:slots*1 ether}(1 ether,uint64(block.timestamp+1 days),1 days,mode,1 hours,"brief",0);}
 function submit()internal{vm.prank(user);s.submitContribution(1,"work");}
 function signature(uint256 id,address who,uint256 x,uint256 post,uint64 end)internal returns(bytes memory){bytes32 digest=keccak256(abi.encode(block.chainid,address(s),id,who,x,post,end));(uint8 v,bytes32 r,bytes32 ss)=vm.sign(pk,keccak256(abi.encodePacked("\x19Ethereum Signed Message:\n32",digest)));return abi.encodePacked(r,ss,v);}
 function enter(address who,uint256 x,uint256 post)internal{uint64 end=uint64(block.timestamp+1 hours);bytes memory sig=signature(1,who,x,post,end);vm.prank(who);s.submitReply(1,"reply",x,post,end,sig);}
 function testCoreLoopAndDoublePayout()public{make(SupportMeStorage.Mode.CreatorChoice,3);submit();vm.prank(creator);s.approveContribution(1);check(user.balance==2 ether);(uint256 submitted,uint256 accepted,uint256 earned)=s.reputation(user);check(submitted==1&&accepted==1&&earned==1 ether);vm.prank(creator);vm.expectRevert(bytes("Already reviewed"));s.approveContribution(1);}
 function testCreatorOnlyAndSelfSubmission()public{make(SupportMeStorage.Mode.CreatorChoice,1);submit();vm.prank(other);vm.expectRevert(bytes("Creator only"));s.approveContribution(1);vm.prank(creator);vm.expectRevert(bytes("Own mission"));s.submitContribution(1,"work");}
 function testDuplicateWallet()public{make(SupportMeStorage.Mode.CreatorChoice,1);submit();vm.prank(user);vm.expectRevert(bytes("Already submitted"));s.submitContribution(1,"again");}
 function testPendingWorkBlocksRefund()public{make(SupportMeStorage.Mode.CreatorChoice,1);submit();vm.prank(creator);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.closeMission(1);}
 function testRejectNeedsPublicReason()public{make(SupportMeStorage.Mode.CreatorChoice,1);submit();vm.prank(creator);vm.expectRevert(bytes("Explain the rejection"));s.rejectContribution(1,"bad");vm.prank(creator);s.rejectContribution(1,"Missing required reproduction steps.");check(bytes(s.rejectionReasons(1)).length>10);vm.prank(creator);s.closeMission(1);check(creator.balance==100 ether);}
 function testMissedReviewAndCleanup()public{make(SupportMeStorage.Mode.PaidSlot,1);vm.prank(user);s.reserveSlot(1);submit();vm.warp(block.timestamp+3 days);vm.prank(creator);vm.expectRevert(bytes("Review ended"));s.approveContribution(1);s.expireReview(1);check(s.activeWork(user)==0);vm.prank(creator);s.closeMission(1);check(creator.balance==100 ether);}
 function testCloseAfterTimeoutDoesNotTrapActiveWork()public{make(SupportMeStorage.Mode.PaidSlot,1);vm.prank(user);s.reserveSlot(1);submit();vm.warp(block.timestamp+3 days);vm.prank(creator);s.closeMission(1);s.expireReview(1);check(s.activeWork(user)==0);}
 function testDeadlineNoNewWorkButTimelyReview()public{make(SupportMeStorage.Mode.CreatorChoice,1);submit();vm.warp(block.timestamp+1 days);vm.prank(other);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.submitContribution(1,"work");vm.prank(creator);s.approveContribution(1);check(user.balance==2 ether);}
 function testPaidSlotRequiredAndLocked()public{make(SupportMeStorage.Mode.PaidSlot,1);vm.prank(user);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.submitContribution(1,"work");vm.prank(user);s.reserveSlot(1);vm.prank(other);vm.expectRevert(bytes("No free slots"));s.reserveSlot(1);vm.prank(creator);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.closeMission(1);submit();vm.prank(creator);s.approveContribution(1);check(s.activeWork(user)==0);}
 function testReservationExpiryPermissionless()public{make(SupportMeStorage.Mode.PaidSlot,1);vm.prank(user);s.reserveSlot(1);vm.prank(other);vm.expectRevert(bytes("Slot still active"));s.releaseSlot(1,user);vm.warp(block.timestamp+1 hours);s.releaseSlot(1,user);vm.prank(other);s.reserveSlot(1);check(s.activeWork(user)==0&&s.activeWork(other)==1);}
 function testMaxThreeActiveJobs()public{for(uint256 i;i<4;i++){make(SupportMeStorage.Mode.PaidSlot,1);vm.prank(user);if(i==3)vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.reserveSlot(i+1);}}
 function testSelectedProposalThenDelivery()public{make(SupportMeStorage.Mode.Selected,1);vm.prank(user);s.submitProposal(1,"concept only");(uint256 count,,)=s.reputation(user);check(count==0);vm.prank(user);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.deliverWork(1,"finished work");vm.prank(creator);s.selectContributor(1);vm.prank(creator);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.closeMission(1);vm.prank(user);s.deliverWork(1,"finished work");check(keccak256(bytes(s.proposalMetadata(1)))==keccak256("concept only"));vm.prank(creator);s.approveContribution(1);check(user.balance==2 ether&&s.activeWork(user)==0);}
 function testAssignedExpiryFreesBudget()public{make(SupportMeStorage.Mode.Selected,1);vm.prank(user);s.submitProposal(1,"concept");vm.prank(creator);s.selectContributor(1);vm.warp(block.timestamp+1 hours);s.expireAssignment(1);check(s.activeWork(user)==0);vm.prank(creator);s.closeMission(1);}
 function testBugKeysCannotPayTwice()public{make(SupportMeStorage.Mode.BugBounty,2);submit();vm.prank(other);s.submitContribution(1,"duplicate bug");bytes32 key=keccak256("wallet-disconnect");vm.prank(creator);vm.expectRevert(bytes("Use mission-specific approval"));s.approveContribution(1);vm.prank(creator);s.approveBug(1,key);vm.prank(creator);vm.expectRevert(bytes("Bug already rewarded"));s.approveBug(2,key);}
 function testRaffleCannotUseManualOrUnsignedEntry()public{make(SupportMeStorage.Mode.ReplyRaffle,1);vm.prank(user);vm.expectRevert(bytes("Use mission-specific submission"));s.submitContribution(1,"fake");vm.prank(user);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.submitReply(1,"fake",1,1,uint64(block.timestamp+1),hex"00");}
 function testTicketBoundToWalletAndMission()public{make(SupportMeStorage.Mode.ReplyRaffle,1);uint64 end=uint64(block.timestamp+1 hours);bytes memory sig=signature(1,user,1,1,end);vm.prank(other);vm.expectRevert(bytes("Invalid verification"));s.submitReply(1,"work",1,1,end,sig);make(SupportMeStorage.Mode.ReplyRaffle,1);vm.prank(user);vm.expectRevert(bytes("Invalid verification"));s.submitReply(2,"work",1,1,end,sig);}
 function testExpiredTicket()public{make(SupportMeStorage.Mode.ReplyRaffle,1);uint64 end=uint64(block.timestamp+10);bytes memory sig=signature(1,user,1,1,end);vm.warp(block.timestamp+11);vm.prank(user);vm.expectRevert(bytes("Verification expired"));s.submitReply(1,"work",1,1,end,sig);}
 function testRaffleDuplicateXAndPost()public{make(SupportMeStorage.Mode.ReplyRaffle,1);enter(user,1,11);uint64 end=uint64(block.timestamp+1 hours);bytes memory sig=signature(1,other,1,12,end);vm.prank(other);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.submitReply(1,"reply",1,12,end,sig);sig=signature(1,other,2,11,end);vm.prank(other);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.submitReply(1,"reply",2,11,end,sig);}
 function testEnteredRaffleMustDrawAndCannotReject()public{make(SupportMeStorage.Mode.ReplyRaffle,1);enter(user,1,11);vm.prank(creator);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.closeMission(1);vm.prank(creator);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.rejectContribution(1,"Trying to exclude an entrant");vm.prank(creator);vm.expectRevert(bytes("Use mission-specific approval"));s.approveContribution(1);}
 function testRaffleOneShotCallbackAndPayout()public{make(SupportMeStorage.Mode.ReplyRaffle,1);enter(user,1,11);enter(other,2,12);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.requestDraw{value:0.0001 ether}(1);vm.warp(block.timestamp+1 days);s.requestDraw{value:0.0001 ether}(1);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.requestDraw{value:0.0001 ether}(1);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s._entropyCallback(1,address(0x123),bytes32(uint256(5)));e.fulfill(1,bytes32(uint256(5)));e.fulfill(1,bytes32(uint256(99)));(,,bytes32 seed,,bool ready,)=s.draws(1);check(seed==bytes32(uint256(5))&&ready);vm.prank(other);s.settleDraw(1);check(user.balance+other.balance==3 ether);vm.expectRevert(bytes("Draw not ready or settled"));s.settleDraw(1);check(address(s).balance==0);}
 function testRaffleFewerEntrantsRefundUnusedPrizes()public{make(SupportMeStorage.Mode.ReplyRaffle,3);enter(user,1,11);vm.warp(block.timestamp+1 days);s.requestDraw{value:0.0001 ether}(1);e.fulfill(1,bytes32(uint256(55)));s.settleDraw(1);check(user.balance==2 ether&&creator.balance==99 ether&&address(s).balance==0);}
 function testEmptyRaffleCanRefund()public{make(SupportMeStorage.Mode.ReplyRaffle,1);vm.prank(creator);s.closeMission(1);check(creator.balance==100 ether);}
 function testRejectedRecipientCanRecover()public{make(SupportMeStorage.Mode.CreatorChoice,1);RejectWallet r=new RejectWallet(s);r.submit(1);vm.prank(creator);s.approveContribution(1);check(s.credits(address(r))==1 ether);r.withdraw(payable(user));check(user.balance==2 ether&&s.credits(address(r))==0);}
 function testRejectedCreatorCanRecover()public{RejectWallet r=new RejectWallet(s);r.create{value:2 ether}();r.close(1);check(s.credits(address(r))==2 ether);r.withdraw(payable(user));check(user.balance==3 ether);}
 function testReentrantReceiverCannotDoublePay()public{make(SupportMeStorage.Mode.CreatorChoice,1);ReenterWallet r=new ReenterWallet(s);r.submit(1);vm.prank(creator);s.approveContribution(1);check(address(r).balance==1 ether&&r.calls()==1);}
 function testFuzzEscrowConservation(uint96 raw,uint8 slotsRaw)public{uint256 reward=uint256(raw)%1 ether+1;uint256 slots=uint256(slotsRaw)%20+1;vm.prank(creator);s.createMissionPaid{value:reward*slots}(reward,uint64(block.timestamp+1 days),259200,SupportMeStorage.Mode.CreatorChoice,86400,"brief",0);submit();vm.prank(creator);s.approveContribution(1);vm.prank(creator);s.closeMission(1);check(address(s).balance==0&&user.balance==1 ether+reward);}
 function testFuzzRaffleNoDuplicateWinners(uint8 raw,bytes32 seed)public{uint256 n=uint256(raw)%10+1;make(SupportMeStorage.Mode.ReplyRaffle,3);for(uint256 i;i<n;i++){address who=address(uint160(100+i));enter(who,100+i,1000+i);}vm.warp(block.timestamp+1 days);s.requestDraw{value:0.0001 ether}(1);e.fulfill(1,seed);s.settleDraw(1);uint256 accepted;for(uint256 i=1;i<=n;i++){(,,SupportMeStorage.Status status,uint256 paid,)=s.contributions(i);if(status==SupportMeStorage.Status.Accepted){accepted++;check(paid==1 ether);}else check(status==SupportMeStorage.Status.NotWinner);}check(accepted==(n<3?n:3)&&address(s).balance==0);}

 function protectedMission(SupportMeStorage.Mode mode,uint16 slots)internal {vm.prank(creator);s.createMissionV3{value:uint256(slots)*1 ether+0.3002 ether}(1 ether,slots,uint64(block.timestamp+300),300,mode,300,"protected",mode==SupportMeStorage.Mode.CreatorChoice||mode==SupportMeStorage.Mode.ReplyRaffle?0.0002 ether:0,mode==SupportMeStorage.Mode.CreatorChoice||mode==SupportMeStorage.Mode.ReplyRaffle?0.3 ether:0.3002 ether,0);}
 function testProtectedPartialSelectionFallsBack()public{protectedMission(SupportMeStorage.Mode.CreatorChoice,2);submit();vm.prank(other);s.submitContribution(1,"other work");vm.prank(creator);s.approveContribution(1);vm.warp(block.timestamp+601);s.requestDraw(1);e.fulfill(1,bytes32(uint256(42)));s.settleDraw(1);(,uint256 accepted,)=s.reputation(other);check(accepted==1&&address(s).balance==0);}
 function testProtectedCannotRejectExpireOrWithdraw()public{protectedMission(SupportMeStorage.Mode.CreatorChoice,1);submit();vm.prank(creator);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.rejectContribution(1,"I do not like this work.");vm.prank(creator);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.closeMission(1);vm.warp(block.timestamp+601);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.expireReview(1);vm.prank(creator);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.closeMission(1);s.requestDraw(1);vm.prank(creator);vm.expectRevert(bytes("Review ended"));s.approveContribution(1);}
 function testProtectedPaidSlotTimeoutPaysAndReleases()public{protectedMission(SupportMeStorage.Mode.PaidSlot,2);vm.prank(user);s.reserveSlot(1);submit();vm.prank(other);s.reserveSlot(1);vm.warp(block.timestamp+601);s.settleOverdueWork(1);check(user.balance==2 ether&&s.activeWork(user)==0&&s.activeWork(other)==0&&address(s).balance==0);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.settleOverdueWork(1);}
 function testProtectedSelectedTimeoutPaysDelivery()public{protectedMission(SupportMeStorage.Mode.Selected,1);vm.prank(user);s.submitProposal(1,"proposal");vm.prank(creator);s.selectContributor(1);vm.prank(user);s.deliverWork(1,"delivery");vm.warp(block.timestamp+601);s.settleOverdueWork(1);check(user.balance==2 ether&&s.activeWork(user)==0&&address(s).balance==0);}
 function testProtectedChosenAllRefundsReserve()public{protectedMission(SupportMeStorage.Mode.CreatorChoice,1);submit();vm.prank(other);s.submitContribution(1,"other");vm.prank(creator);s.approveContribution(1);vm.prank(creator);s.closeMission(1);check(address(s).balance==0&&creator.balance==99 ether);(,,SupportMeStorage.Status status,,)=s.contributions(2);check(status==SupportMeStorage.Status.NotWinner);}
 function testProtectedDrawCannotStartDuringReview()public{protectedMission(SupportMeStorage.Mode.CreatorChoice,1);submit();vm.warp(block.timestamp+300);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.requestDraw(1);vm.warp(block.timestamp+301);s.requestDraw(1);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.requestDraw(1);e.fulfill(1,bytes32(uint256(1)));s.settleDraw(1);vm.expectRevert(bytes("Draw not ready or settled"));s.settleDraw(1);check(address(s).balance==0);}

 function testProtectedFeeIncreaseCannotConsumePrizes()public{protectedMission(SupportMeStorage.Mode.CreatorChoice,1);submit();vm.warp(block.timestamp+601);e.setFee(0.0003 ether);vm.expectRevert(bytes("Pyth reserve insufficient"));s.requestDraw(1);(,,uint256 remaining,,,)=s.missions(1);check(remaining==1 ether);s.topUpAutomation{value:0.0001 ether}(1);s.requestDraw(1);e.fulfill(1,bytes32(uint256(9)));s.settleDraw(1);check(user.balance==2 ether&&address(s).balance==0);}
 function testProtectedEmptyRefundPermissionlessAfterReview()public{protectedMission(SupportMeStorage.Mode.CreatorChoice,1);vm.warp(block.timestamp+601);s.closeMission(1);check(creator.balance==100 ether&&address(s).balance==0);}
 function testProtectedUndeliveredSelectedNeverPaid()public{protectedMission(SupportMeStorage.Mode.Selected,1);vm.prank(user);s.submitProposal(1,"proposal");vm.prank(creator);s.selectContributor(1);vm.warp(block.timestamp+601);s.settleOverdueWork(1);check(user.balance==1 ether&&s.activeWork(user)==0&&creator.balance==100 ether);}
 function testFuzzProtectedPartialDrawConservesEscrow(uint8 raw,bytes32 seed)public{uint16 slots=uint16(uint256(raw)%5+1);protectedMission(SupportMeStorage.Mode.CreatorChoice,slots);for(uint256 i;i<8;i++){vm.prank(address(uint160(100+i)));s.submitContribution(1,"work");}vm.prank(creator);s.approveContribution(1);vm.warp(block.timestamp+601);if(slots>1){s.requestDraw(1);e.fulfill(1,seed);s.settleDraw(1);}else s.closeMission(1);uint256 accepted;uint256 paid;for(uint256 i=1;i<=8;i++){(,,SupportMeStorage.Status status,uint256 amount,)=s.contributions(i);if(status==SupportMeStorage.Status.Accepted)accepted++;paid+=amount;}check(accepted==slots&&paid==uint256(slots)*1 ether&&address(s).balance==0);}
 receive()external payable{}
}


