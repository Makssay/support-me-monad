pragma solidity 0.8.28;
import "./SupportMe.t.sol";
import "../contracts/AIContestController.sol";
import "./MockRewardToken.sol";
contract TokenRewardsTest {
 Vm constant vm=Vm(address(uint160(uint256(keccak256("hevm cheat code")))));SupportMe s;MockEntropy e;address creator=address(0xA);address user=address(0xB);address other=address(0xC);uint256 pk=123456;
 function baseSetup()internal{e=new MockEntropy();s=new SupportMe(address(e),vm.addr(pk),address(0));vm.deal(address(this),100 ether);vm.deal(creator,100 ether);vm.deal(user,1 ether);vm.deal(other,1 ether);}
 function check(bool b)internal pure{require(b,"Assertion failed");}
 function make(SupportMeStorage.Mode mode,uint256 slots)internal{vm.prank(creator);s.createMissionPaid{value:slots*1 ether}(1 ether,uint64(block.timestamp+1 days),1 days,mode,1 hours,"brief",0);}
 function submit()internal{vm.prank(user);s.submitContribution(1,"work");}
 function signature(uint256 id,address who,uint256 x,uint256 post,uint64 end)internal returns(bytes memory){bytes32 digest=keccak256(abi.encode(block.chainid,address(s),id,who,x,post,end));(uint8 v,bytes32 r,bytes32 ss)=vm.sign(pk,keccak256(abi.encodePacked("\x19Ethereum Signed Message:\n32",digest)));return abi.encodePacked(r,ss,v);}
 function enter(address who,uint256 x,uint256 post)internal{uint64 end=uint64(block.timestamp+1 hours);bytes memory sig=signature(1,who,x,post,end);vm.prank(who);s.submitReply(1,"reply",x,post,end,sig);}

 MockRewardToken token;uint64 expiry;
 function setUp()public virtual{baseSetup();token=new MockRewardToken();token.mint(creator,100000000);expiry=uint64(block.timestamp+1 days);}
 function permitToken(address target)internal returns(bytes memory){bytes32 d=keccak256(abi.encode("Support Me reward token",block.chainid,address(s),target,expiry));(uint8 v,bytes32 r,bytes32 ss)=vm.sign(pk,keccak256(abi.encodePacked("\x19Ethereum Signed Message:\n32",d)));return abi.encodePacked(r,ss,v);}
 function makeToken(SupportMeStorage.Mode mode,bool protectedMode,uint16 slots)internal{bytes memory sig=permitToken(address(token));vm.prank(creator);token.approve(address(s),uint256(slots)*1000000);vm.prank(creator);s.createTokenMission{value:protectedMode?(mode==SupportMeStorage.Mode.CreatorChoice||mode==SupportMeStorage.Mode.ReplyRaffle?0.3002 ether:0.3 ether):0}(SupportMeStorage.TokenMission(address(token),1000000,slots,uint64(block.timestamp+1 hours),300,mode,300,protectedMode,protectedMode&&(mode==SupportMeStorage.Mode.CreatorChoice||mode==SupportMeStorage.Mode.ReplyRaffle)?0.0002 ether:0,protectedMode?0.3 ether:0,0),"token brief",expiry,sig);}
 function testTokenCoreLoopAndNoDoublePayout()public{makeToken(SupportMeStorage.Mode.CreatorChoice,false,2);submit();vm.prank(creator);s.approveContribution(1);check(token.balanceOf(user)==1000000);check(s.tokenEarned(user,address(token))==1000000);(,,uint256 mon)=s.reputation(user);check(mon==0);vm.prank(creator);vm.expectRevert(bytes("Already reviewed"));s.approveContribution(1);vm.prank(creator);s.closeMission(1);check(token.balanceOf(creator)==99000000&&token.balanceOf(address(s))==0);}
 function testRejectTaxedFundingAtomically()public{token.settings(true,false,false,false);bytes memory sig=permitToken(address(token));vm.prank(creator);token.approve(address(s),2000000);vm.prank(creator);vm.expectRevert(bytes(""));s.createTokenMission(SupportMeStorage.TokenMission(address(token),1000000,2,uint64(block.timestamp+1 hours),300,SupportMeStorage.Mode.CreatorChoice,300,false,0,0,0),"brief",expiry,sig);check(s.missionCount()==0&&token.balanceOf(creator)==100000000);}
 function testNoReturnTokenSupported()public{token.settings(false,false,false,true);makeToken(SupportMeStorage.Mode.CreatorChoice,false,1);submit();vm.prank(creator);s.approveContribution(1);check(token.balanceOf(user)==1000000);}
 function testPausedPayoutCreatesRecoverableTokenCredit()public{makeToken(SupportMeStorage.Mode.CreatorChoice,false,1);submit();token.settings(false,true,false,false);vm.prank(creator);s.approveContribution(1);check(s.tokenCredits(user,address(token))==1000000);token.settings(false,false,false,false);vm.prank(user);s.withdrawTokenCredit(address(token),user);check(token.balanceOf(user)==1000000&&s.tokenCredits(user,address(token))==0);}
 function testTaxedPayoutRollsBackAndCanRetry()public{makeToken(SupportMeStorage.Mode.CreatorChoice,false,1);submit();token.settings(true,false,false,false);vm.prank(creator);s.approveContribution(1);check(token.balanceOf(user)==0&&token.balanceOf(address(s))==1000000&&s.tokenCredits(user,address(token))==1000000);token.settings(false,false,false,false);vm.prank(user);s.withdrawTokenCredit(address(token),user);check(token.balanceOf(user)==1000000);}
 function testFalseReturnFundingCannotCreateMission()public{token.settings(false,false,true,false);bytes memory sig=permitToken(address(token));vm.prank(creator);token.approve(address(s),1000000);vm.prank(creator);vm.expectRevert(bytes(""));s.createTokenMission(SupportMeStorage.TokenMission(address(token),1000000,1,uint64(block.timestamp+1 hours),300,SupportMeStorage.Mode.CreatorChoice,300,false,0,0,0),"brief",expiry,sig);check(s.missionCount()==0);}
 function testTokenAdmissionCannotReplayOnAnotherContract()public{bytes memory sig=permitToken(address(token));SupportMe otherEscrow=new SupportMe(address(e),vm.addr(pk),address(0));vm.prank(creator);token.approve(address(otherEscrow),1000000);vm.prank(creator);vm.expectRevert(bytes("Invalid verification"));otherEscrow.createTokenMission(SupportMeStorage.TokenMission(address(token),1000000,1,uint64(block.timestamp+1 hours),300,SupportMeStorage.Mode.CreatorChoice,300,false,0,0,0),"brief",expiry,sig);}
 function testTokenAdmissionExpires()public{bytes memory sig=permitToken(address(token));vm.warp(expiry+1);vm.expectRevert(bytes(""));s.createTokenMission(SupportMeStorage.TokenMission(address(token),1000000,1,uint64(block.timestamp+1 hours),300,SupportMeStorage.Mode.CreatorChoice,300,false,0,0,0),"brief",expiry,sig);}
 function testTokenRandomFallbackAndMonReservesSeparate()public{makeToken(SupportMeStorage.Mode.CreatorChoice,true,2);submit();(,,,uint64 end,,)=s.missions(1);vm.warp(end+301);s.requestDraw(1);e.fulfill(1,keccak256("seed"));s.settleDraw(1);check(token.balanceOf(user)==1000000&&token.balanceOf(creator)==99000000&&token.balanceOf(address(s))==0);check(address(s).balance==0&&s.randomReward(1));}
 function testNativeBalanceCannotFundTokenPrize()public{bytes memory sig=permitToken(address(token));vm.prank(creator);vm.expectRevert(bytes("Incorrect total funding"));s.createTokenMission{value:1 ether}(SupportMeStorage.TokenMission(address(token),1000000,1,uint64(block.timestamp+1 hours),300,SupportMeStorage.Mode.CreatorChoice,300,false,0,0,0),"brief",expiry,sig);}
 function testTokenAIContestRefund()public{AIContestController a=new AIContestController(address(s),vm.addr(pk));bytes memory sig=permitToken(address(token));vm.prank(creator);token.approve(address(a),2000000);vm.prank(creator);a.createTokenContest(address(token),1000000,2,uint64(block.timestamp+1 hours),300,"AI brief",expiry,sig);check(token.balanceOf(address(s))==2000000&&token.allowance(address(a),address(s))==0);vm.prank(creator);a.cancelOrRefund(1);check(token.balanceOf(creator)==100000000&&token.balanceOf(address(s))==0&&token.balanceOf(address(a))==0);}
 function testFuzzTokenConservation(uint16 n)public{uint16 slots=uint16(uint256(n)%100+1);makeToken(SupportMeStorage.Mode.CreatorChoice,false,slots);submit();vm.prank(creator);s.approveContribution(1);vm.prank(creator);s.closeMission(1);check(token.balanceOf(creator)+token.balanceOf(user)==100000000);}

 function testTokenPaidSlotTimeoutPaysSubmittedWork()public{makeToken(SupportMeStorage.Mode.PaidSlot,true,2);vm.prank(user);s.reserveSlot(1);submit();(,,,uint64 end,,)=s.missions(1);vm.warp(end+301);s.settleOverdueWork(1);check(token.balanceOf(user)==1000000&&token.balanceOf(creator)==99000000&&token.balanceOf(address(s))==0);}
 function testTokenSelectedWorkTimeoutPaysDelivery()public{makeToken(SupportMeStorage.Mode.Selected,true,2);vm.prank(user);s.submitProposal(1,"proposal");vm.prank(creator);s.selectContributor(1);vm.prank(user);s.deliverWork(1,"delivered work");(,,,uint64 end,,)=s.missions(1);vm.warp(end+301);s.settleOverdueWork(1);check(token.balanceOf(user)==1000000&&token.balanceOf(creator)==99000000&&token.balanceOf(address(s))==0);}
 function testTokenBugBountyPayout()public{makeToken(SupportMeStorage.Mode.BugBounty,false,1);submit();vm.prank(creator);s.approveBug(1,keccak256("unique bug"));check(token.balanceOf(user)==1000000);}
 function testTokenReplyRafflePayout()public{makeToken(SupportMeStorage.Mode.ReplyRaffle,true,2);enter(user,111,222);(,,,uint64 end,,)=s.missions(1);vm.warp(end);s.requestDraw(1);e.fulfill(1,keccak256("seed"));s.settleDraw(1);check(token.balanceOf(user)==1000000&&token.balanceOf(creator)==99000000&&token.balanceOf(address(s))==0);}
 function testTokenAISignedSettlementPaysAndRefunds()public{AIContestController a=new AIContestController(address(s),vm.addr(pk));bytes memory admission=permitToken(address(token));vm.prank(creator);token.approve(address(a),2000000);uint64 end=uint64(block.timestamp+1 hours);vm.prank(creator);a.createTokenContest(address(token),1000000,2,end,300,"frozen brief",expiry,admission);submit();uint256[] memory w=new uint256[](1);w[0]=1;bytes32 result=keccak256("ranking");uint64 until=end+300;bytes32 d=keccak256(abi.encode(block.chainid,address(a),uint256(1),a.policyHashes(1),keccak256(abi.encode(s.raffleEntries(1))),keccak256(abi.encode(w)),result,until));(uint8 v,bytes32 r,bytes32 ss)=vm.sign(pk,keccak256(abi.encodePacked("\x19Ethereum Signed Message:\n32",d)));vm.warp(end);a.settleContest(1,w,result,until,abi.encodePacked(r,ss,v));check(token.balanceOf(user)==1000000&&token.balanceOf(creator)==99000000&&token.balanceOf(address(s))==0&&token.balanceOf(address(a))==0);}

 function testRecoveryERC20IgnoresPausedTransfersAndPreservesClaim()public{
  makeToken(SupportMeStorage.Mode.ReplyRaffle,true,1);enter(user,1,11);enter(other,2,12);token.settings(false,true,false,false);vm.warp(s.recoveryAt(1));s.recoverUnavailableDraw(1);
  check(s.tokenCredits(creator,address(token))==1000000&&s.tokenCredits(user,address(token))==0&&s.tokenCredits(other,address(token))==0);(,,,,bool closed,)=s.missions(1);check(closed);
  vm.prank(creator);vm.expectRevert(bytes(""));s.withdrawTokenCredit(address(token),other);check(s.tokenCredits(creator,address(token))==1000000);
  token.settings(false,false,false,false);vm.prank(creator);s.withdrawTokenCredit(address(token),other);check(token.balanceOf(other)==1000000&&token.balanceOf(address(s))==0);
 }
 function testPartialCreditsCannotWithdrawAnotherUsersBalance()public{
  makeToken(SupportMeStorage.Mode.CreatorChoice,false,1);submit();token.settings(false,true,false,false);vm.prank(creator);s.approveContribution(1);token.settings(false,false,false,false);
  vm.prank(user);s.withdrawTokenCreditAmount(address(token),other,400000);check(s.tokenCredits(user,address(token))==600000&&token.balanceOf(other)==400000);
  vm.prank(other);vm.expectRevert(bytes("No credit"));s.withdrawTokenCreditAmount(address(token),other,1);
  vm.prank(user);s.withdrawTokenCredit(address(token),other);check(token.balanceOf(other)==1000000&&token.balanceOf(address(s))==0);
 }
 function testPausedAIRefundClosesAndKeepsClaimBackedByEscrow()public{
  AIContestController a=new AIContestController(address(s),vm.addr(pk));bytes memory sig=permitToken(address(token));vm.prank(creator);token.approve(address(a),1000000);
  vm.prank(creator);a.createTokenContest(address(token),1000000,1,uint64(block.timestamp+1 hours),300,"brief",expiry,sig);
  token.settings(false,true,false,false);vm.warp(block.timestamp+4000);vm.prank(other);a.cancelOrRefund(1);(,,,,bool closed,)=s.missions(1);check(closed&&a.tokenCredits(creator,address(token))==1000000);
  token.settings(false,false,false,false);vm.prank(creator);a.withdrawTokenCredit(address(token),other);check(token.balanceOf(other)==1000000&&s.tokenCredits(address(a),address(token))==0&&a.tokenCredits(creator,address(token))==0);
 }
}



