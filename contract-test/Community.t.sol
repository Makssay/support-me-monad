pragma solidity 0.8.28;
import "./SupportMe.t.sol";
contract CommunityTest {
 Vm constant vm=Vm(address(uint160(uint256(keccak256("hevm cheat code")))));SupportMe s;CommunityGate g;MockEntropy e;uint256 pk=123456;address creator=address(0xA);address user=address(0xB);address other=address(0xC);bytes32 policy=keccak256("fixed list");
 function setUp()public{e=new MockEntropy();s=new SupportMe(address(e),vm.addr(pk),address(0));g=s.communityGate();vm.deal(address(this),100 ether);vm.deal(creator,100 ether);vm.deal(user,2 ether);vm.deal(other,2 ether);}
 function sign(bytes32 digest)internal returns(bytes memory){(uint8 v,bytes32 r,bytes32 ss)=vm.sign(pk,keccak256(abi.encodePacked("\x19Ethereum Signed Message:\n32",digest)));return abi.encodePacked(r,ss,v);}
 function make(SupportMeStorage.Mode mode,bool recheck)internal{SupportMeStorage.TokenMission memory f=SupportMeStorage.TokenMission(address(0),1 ether,1,uint64(block.timestamp+1 days),1 days,mode,1 hours,false,0,0,0);vm.prank(creator);s.createGatedMission{value:1 ether}(f,"brief",policy,recheck,1 days,0,"");}
 function ticket(uint256 id,address who,bytes32 identity,uint64 end)internal returns(bytes32[] memory ids,bytes memory sig){ids=new bytes32[](1);ids[0]=identity;sig=sign(keccak256(abi.encode("Support Me community admission",block.chainid,address(g),address(s),id,policy,who,keccak256(abi.encode(ids)),end)));}
 function admit(address who,bytes32 identity)internal{uint64 end=uint64(block.timestamp+300);(bytes32[] memory ids,bytes memory sig)=ticket(1,who,identity,end);g.authorize(1,who,ids,end,sig);}
 function finalTicket(uint256[] memory rejected)internal returns(bytes memory){uint64 end=uint64(block.timestamp+300);return sign(keccak256(abi.encode("Support Me community final check",block.chainid,address(g),address(s),uint256(1),policy,keccak256(abi.encode(s.raffleEntries(1))),keccak256(abi.encode(rejected)),end)));}
 function testDirectSubmissionCannotBypassGate()public{make(SupportMeStorage.Mode.CreatorChoice,false);vm.prank(user);vm.expectRevert(bytes("Verify community eligibility first"));s.submitContribution(1,"work");admit(user,keccak256("user"));vm.prank(user);s.submitContribution(1,"work");vm.prank(creator);s.approveContribution(1);require(user.balance==3 ether);}
 function testReservationsRequireAdmission()public{make(SupportMeStorage.Mode.PaidSlot,false);vm.prank(user);vm.expectRevert(bytes("Verify community eligibility first"));s.reserveSlot(1);admit(user,keccak256("user"));vm.prank(user);s.reserveSlot(1);}
 function testIdentityCannotBeReusedByAnotherWallet()public{make(SupportMeStorage.Mode.CreatorChoice,false);bytes32 identity=keccak256("same discord");admit(user,identity);(bytes32[] memory ids,bytes memory sig)=ticket(1,other,identity,uint64(block.timestamp+300));vm.expectRevert(bytes("Identity already entered"));g.authorize(1,other,ids,uint64(block.timestamp+300),sig);}
 function testTicketIsBoundToWalletAndMission()public{make(SupportMeStorage.Mode.CreatorChoice,false);uint64 end=uint64(block.timestamp+300);(bytes32[] memory ids,bytes memory sig)=ticket(1,user,keccak256("identity"),end);vm.expectRevert(bytes("Invalid verification"));g.authorize(1,other,ids,end,sig);}
 function testExpiredTicketRejected()public{make(SupportMeStorage.Mode.CreatorChoice,false);uint64 end=uint64(block.timestamp+10);(bytes32[] memory ids,bytes memory sig)=ticket(1,user,keccak256("identity"),end);vm.warp(block.timestamp+11);vm.expectRevert(bytes("Admission expired"));g.authorize(1,user,ids,end,sig);}
 function testOnlyEscrowCanSetPolicy()public{make(SupportMeStorage.Mode.CreatorChoice,false);vm.expectRevert(bytes("Immutable policy"));g.setPolicy(1,keccak256("changed"),false,1 days);}
 function testCommunityRafflePaysWithoutSocialSubmission()public{make(SupportMeStorage.Mode.CommunityRaffle,false);admit(user,keccak256("user"));vm.prank(user);s.enterCommunity(1,"entry");vm.prank(creator);vm.expectRevert(bytes("Use mission-specific approval"));s.approveContribution(1);vm.warp(block.timestamp+1 days);s.requestDraw{value:0.0001 ether}(1);e.fulfill(1,bytes32(uint256(42)));s.settleDraw(1);require(user.balance==3 ether);}
 function testRecheckedRaffleCannotDrawPartialList()public{make(SupportMeStorage.Mode.CommunityRaffle,true);admit(user,keccak256("user"));vm.prank(user);s.enterCommunity(1,"entry");vm.warp(block.timestamp+1 days);vm.expectRevert(bytes("Community final check pending"));s.requestDraw{value:0.0001 ether}(1);uint256[] memory excluded=new uint256[](0);bytes memory sig=finalTicket(excluded);g.finalize(1,excluded,uint64(block.timestamp+300),sig);s.requestDraw{value:0.0001 ether}(1);e.fulfill(1,bytes32(uint256(123)));s.settleDraw(1);require(user.balance==3 ether);}
 function testUnavailableFinalCheckEventuallyRefundsInsteadOfPickingSubset()public{make(SupportMeStorage.Mode.CommunityRaffle,true);admit(user,keccak256("user"));vm.prank(user);s.enterCommunity(1,"entry");vm.prank(creator);vm.expectRevert(abi.encodeWithSelector(SupportMeStorage.InvalidParameters.selector));s.closeMission(1);vm.warp(block.timestamp+2 days+1);vm.prank(creator);s.closeMission(1);require(creator.balance==100 ether&&user.balance==2 ether);}
 function testFinalCheckExcludesOnlySignedEntriesAndAllIneligibleRefund()public{make(SupportMeStorage.Mode.CommunityRaffle,true);admit(user,keccak256("user"));vm.prank(user);s.enterCommunity(1,"entry");vm.warp(block.timestamp+1 days);uint256[] memory rejected=new uint256[](1);rejected[0]=1;bytes memory sig=finalTicket(rejected);g.finalize(1,rejected,uint64(block.timestamp+300),sig);require(g.refundable(1));vm.prank(creator);s.closeMission(1);require(creator.balance==100 ether);}
 function testSnapshotRandomnessIsScopedAndCannotReroll()public{bytes32 hash=keccak256("snapshot");uint64 end=uint64(block.timestamp+300);bytes memory sig=sign(keccak256(abi.encode("Support Me holder tie draw",block.chainid,address(g),hash,end)));g.requestSnapshot{value:0.0001 ether}(hash,end,sig);e.fulfill(1,bytes32(uint256(999)));require(g.snapshotReady(hash)&&g.snapshotSeeds(hash)==bytes32(uint256(999)));vm.expectRevert(bytes("Snapshot unavailable"));g.requestSnapshot{value:0.0001 ether}(hash,end,sig);}
}


