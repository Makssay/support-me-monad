# Server / deployment only. NEVER add VITE_ prefixes to these secrets.
MONAD_PRIVATE_KEY=
MONAD_RPC_URL=
OPENROUTER_API_KEY=
# Conservative persistent reservation across AI calls, including failures. No automatic retries.
AI_BUDGET_USD=0.25
SOCIAL_DATA_API_KEY=
# SOCIALDATA_API_KEY is also accepted. Spending caps persist in .data/.
SOCIAL_LOOKUP_DAILY_LIMIT=100
SOCIAL_LOOKUP_TOTAL_LIMIT=1000
# Public identifier served by /api/config. No VITE_ env variables needed.
PRIVY_APP_ID=
# Enable only after configuring Privy gas sponsorship for Monad Testnet.
# Applies to Privy embedded wallets; external wallets keep paying their gas.
PRIVY_GAS_SPONSORSHIP=0
# Server-only. Not needed for frontend wallets and wallet-signed social checks.
PRIVY_APP_SECRET=
# Optional public deployment overrides (normally loaded from deployment.json).
CONTRACT_ADDRESS=
DEPLOYMENT_BLOCK=
PORT=3001
# Local QA only. Keep 0 outside local tests; the server refuses non-local RPCs.
LOCAL_E2E=0

# Default is Monad TESTNET. Mainnet needs separate matching deployment files.
MONAD_CHAIN_ID=10143
# Separate mainnet executor key; never reuse MONAD_PRIVATE_KEY or a seed phrase.
MAINNET_PRIVATE_KEY=

# Public address receiving withdrawal rights for creation fees. Defaults to deployer.
PLATFORM_TREASURY=

# Optional Discord OAuth. Never expose the client secret in frontend variables.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# OAuth callback: APP_ORIGIN/api/community/discord/callback
APP_ORIGIN=http://127.0.0.1:3001
# Bounded archive RPC log ranges when preparing an ERC-721 holder snapshot.
HOLDER_SNAPSHOT_MAX_RANGES=2000
# Local fixtures only, never enabled on Monad.
COMMUNITY_FIXTURES=0

# Local defaults to atomic files. Cloud API MUST use D1 (never ephemeral files).
STORAGE_MODE=local
# Server-only D1 gateway; separate random secrets for storage and scheduler.
D1_GATEWAY_URL=
D1_GATEWAY_SECRET=
SCHEDULER_SECRET=
# Dedicated eligibility signer matching deployment.verifier; not a funded wallet.
SOCIAL_VERIFIER_PRIVATE_KEY=
# 32-byte AES key as 64 hex characters. Preserve when migrating encrypted Discord tokens.
COMMUNITY_ENCRYPTION_KEY=
# Disable local executor while Cloudflare cron is active for the same wallet.
AUTOMATION_DISABLED=0

# Dynamic trial: keep Privy available until existing wallets are migrated.
AUTH_PROVIDER=privy
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_ALLOWED_ORIGINS=https://support-me-monad.vercel.app,https://support-me-monad.support-me.workers.dev,http://127.0.0.1:3001
# Enable only after Sponsor Gas is enabled and a live transaction succeeds.
DYNAMIC_GAS_SPONSORSHIP=0

# Optional external-wallet login. Keep disabled until end-to-end verification passes.
WALLET_AUTH_ENABLED=0
WALLET_AUTH_X_POST=https://x.com/Makssay_eth/status/2109778998876119439
