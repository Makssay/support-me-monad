{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": { "api/*.js": { "maxDuration": 240, "includeFiles": "{.server/**,deployment.json,ai-deployment.json,mainnet-deployment.json,mainnet-ai-deployment.json,artifacts/SupportMe.json}" } },
  "rewrites": [
    { "source": "/api/internal/tick", "destination": "/api/executor" },
    { "source": "/api/snapshot-refresh", "destination": "/api/snapshot" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"}]}]
}
