{
  "name": "support-me",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-api.mjs",
    "start": "tsx server/index.ts",
    "contract:compile": "tsx scripts/compile.ts",
    "contract:test": "forge test -vv",
    "contract:deploy": "tsx scripts/deploy.ts",
    "contract:verify": "tsx scripts/verify-source.ts && tsx scripts/check-source.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "chain:check": "tsx scripts/check-chain.ts",
    "demo:onchain": "tsx scripts/demo-v2.ts",
    "ai:deploy": "tsx scripts/deploy-ai.ts",
    "ai:check": "tsx scripts/check-ai-chain.ts",
    "ai:live-check": "tsx scripts/ai-live-check.ts",
    "ai:demo": "tsx scripts/demo-ai.ts",
    "verify:onchain": "tsx scripts/verify-chain.ts",
    "test:production": "tsx scripts/production-smoke.ts",
    "test:privy": "tsx scripts/privy-smoke.ts",
    "secrets:check": "tsx scripts/check-secrets.ts",
    "test:monad": "tsx scripts/all-scenarios-monad.ts",
    "verify:scenarios": "tsx scripts/verify-all-scenarios.ts",
    "test:automation": "tsx scripts/run-e2e.ts --automation e2e/automation.spec.ts"
  },
  "dependencies": {
    "@dynamic-labs/ethereum-core": "^5.10.0",
    "@dynamic-labs/ethereum-gasless-core": "^5.10.0",
    "@dynamic-labs/sdk-api-core": "^0.70.0",
    "@dynamic-labs/sdk-react-core": "^5.10.0",
    "@dynamic-labs/waas-evm": "^5.10.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@privy-io/node": "^0.35.0",
    "@privy-io/react-auth": "^3.47.0",
    "compression": "^1.8.2",
    "dotenv": "^16.5.0",
    "ethers": "^6.14.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.511.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.6.0",
    "viem": "^2.56.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.12",
    "miniflare": "5.20261006.1-alpha",
    "sharp": "^0.35.5",
    "solc": "0.8.28",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "shell-quote": "^1.11.0",
    "ws@>=8 <9": "^8.22.0",
    "decode-uri-component": "^0.5.0"
  }
}
